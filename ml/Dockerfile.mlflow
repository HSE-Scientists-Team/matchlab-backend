FROM ghcr.io/mlflow/mlflow:v3.17.1@sha256:65aa7a75fe37554bd7dd9e539b58e1ec130dac99f27fef9756df316a272dfee2
USER root
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir setuptools==84.0.0 && pip check

# Match the UID already enforced by the cluster. Prepare new local volumes too.
RUN useradd --uid 50000 --gid 0 --create-home --home-dir /home/mlflow mlflow \
    && mkdir -p /mlflow \
    && chown 50000:0 /mlflow \
    && chmod g+rwx /mlflow
ENV HOME=/home/mlflow USER=mlflow
WORKDIR /mlflow
USER 50000:0
